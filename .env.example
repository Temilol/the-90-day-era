# Cloud sync (optional). Copy to .env.local and fill in from Supabase → Project Settings → API.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Set to true only if the Supabase email templates send a code ({{ .Token }}) instead of a link.
VITE_AUTH_EMAIL_CODES=
# Push reminders (optional). Created by `npm run push:keys`. Public, safe to expose.
VITE_VAPID_PUBLIC_KEY=
